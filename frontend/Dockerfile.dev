# Desarrollo offline-first: la imagen publicada/local ya contiene Node, pnpm
# y node_modules. Este build solo actualiza el código de la aplicación.
ARG BASE_IMAGE=raisiar/proyecto-de-sistemas-frontend:1.0.7
FROM ${BASE_IMAGE}

USER root
WORKDIR /app
COPY --chown=node:node . .
USER node

EXPOSE 3000
CMD ["pnpm", "dev", "--host", "0.0.0.0", "--port", "3000"]
