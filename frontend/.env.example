# URL base de la API (relativa al proxy para producción)
VITE_API_URL=/api

# Cloudinary: nombre del cloud usado para construir las URLs de entrega de
# imágenes del catálogo (https://res.cloudinary.com/<CLOUD_NAME>/...).
#
# El backend todavía NO expone imágenes de los destinos; cuando empiece a
# mandarlas, el frontend las consume sin cambios. Solo hace falta esta
# variable si el backend devuelve un public_id suelto en vez de una URL
# absoluta ya firmada.
#
# VITE_CLOUDINARY_CLOUD_NAME=tu_cloud_name
