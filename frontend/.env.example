# URL base de la API (relativa al proxy para producción)
VITE_API_URL=/api

# Cloudinary: nombre del cloud usado para construir las URLs de entrega de
# las imágenes de los destinos (https://res.cloudinary.com/<CLOUD_NAME>/...).
#
# El backend expone los `public_id` de las fotos del destino en
# `Atractivo.imagenes`; el frontend los convierte a URLs con esta variable.
# Si el backend mandara URLs absolutas ya firmadas, el frontend las respeta
# y esto no se usa. Debe coincidir con CLOUDINARY_CLOUD_NAME del backend.
VITE_CLOUDINARY_CLOUD_NAME=tu_cloud_name
