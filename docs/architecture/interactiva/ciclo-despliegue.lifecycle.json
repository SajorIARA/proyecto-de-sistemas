      "col": 0,
      "tag": "terminal"
    },
    {
      "id": "failed",
      "type": "failure",
      "label": "Fallido",
      "sublabel": "rollback sin éxito",
      "lane": "terminal",
      "col": 1,
      "tag": "terminal"
    },
    {
      "id": "rolled_back",
      "type": "success",
      "label": "Rolled Back",
      "sublabel": "servicio restaurado",
      "lane": "terminal",
      "col": 2,
      "tag": "terminal"
    }
