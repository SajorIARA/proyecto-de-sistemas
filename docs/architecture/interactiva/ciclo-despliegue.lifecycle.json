      "col": 1,
      "step": "02",
      "tag": "automático"
    },
    {
      "id": "staging",
      "type": "decision",
      "label": "staging (dev)",
      "sublabel": "despliegue + healthchecks",
      "lane": "main",
      "col": 2,
      "step": "03",
      "tag": "gate"
    },
    {
      "id": "salud",
      "type": "waiting",
      "label": "Salud del servicio",
      "sublabel": "endpoints verdes",
      "lane": "main",
      "col": 3,
      "step": "04",
      "tag": "approved"
    },
    {
      "id": "prod",
      "type": "success",
      "label": "production (main)",
      "sublabel": "sistema en vivo",
      "lane": "main",
      "col": 4,
      "step": "05",
      "tag": "success"
    },
    {
      "id": "apro",
      "type": "waiting",
      "label": "Revisión PR",
      "sublabel": "rulesets + aprobación",
      "lane": "waiting",
      "col": 0,
      "tag": "pause"
    },
    {
      "id": "paused",
      "type": "waiting",
      "label": "Salud degradada",
      "sublabel": "SLO por debajo",
      "lane": "waiting",
      "col": 2,
      "tag": "observe"
    },
    {
      "id": "rollback",
      "type": "active",
      "label": "Rollback",
      "sublabel": "última imagen buena",
