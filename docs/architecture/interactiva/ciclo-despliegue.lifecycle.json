      "route": "straight",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "from": "paused",
      "to": "rolled_back",
      "variant": "emphasis",
      "route": "straight",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "from": "rollback",
      "to": "failed",
      "variant": "security",
      "route": "straight",
      "fromSide": "bottom",
      "toSide": "top"
    }
  ]
