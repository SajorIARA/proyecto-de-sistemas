    "visual_preset": "signal-flow",
    "animation": "trace",
    "viewBox": [
      980,
      680
    ],
    "views": [
      {
        "id": "promocion",
        "label": "Ferrocarril de promoción",
        "focus": [
          "commit",
          "ci",
          "staging",
          "salud",
          "prod"
        ],
        "note": "Un cambio avanza por las etapas hasta producción."
      },
      {
        "id": "puertas",
        "label": "Puertas de seguridad",
        "focus": [
          "staging",
          "apro",
          "cancelled"
        ],
        "note": "La revisión del PR puede detener la promoción limpiamente."
      },
      {
        "id": "recuperacion",
        "label": "Rollback",
        "focus": [
          "prod",
          "rollback",
          "paused",
          "rolled_back",
          "failed"
        ],
        "note": "Una regresión vuelve a la última imagen buena."
      }
    ]
  },
  "lanes": [
    {
      "id": "main",
      "label": "Release phases"
    },
    {
      "id": "waiting",
      "label": "Auditoría + salud"
    },
    {
      "id": "recovery",
      "label": "Control de rollback"
    },
    {
      "id": "terminal",
      "label": "Salidas terminales"
    }
  ],
  "states": [
    {
      "id": "commit",
      "type": "start",
      "label": "Commit / Push",
      "sublabel": "cambios validados",
      "lane": "main",
      "col": 0,
      "step": "01",
      "tag": "inicio"
    },
    {
      "id": "ci",
      "type": "active",
      "label": "CI / PR",
      "sublabel": "tests · Trivy · build",
