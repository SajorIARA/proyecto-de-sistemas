worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    sendfile on;
    server_tokens off;

    # Timeouts
    client_body_timeout 15;
    client_header_timeout 15;
    keepalive_timeout 65;
    send_timeout 15;
    proxy_connect_timeout 10;
    proxy_send_timeout 60;
    proxy_read_timeout 60;

    # Tamaño máximo del cuerpo de las peticiones (subidas de documentos/imágenes)
    client_max_body_size 10m;

    # Resolver de la red privada.
    #   Docker Compose: 127.0.0.11 (DNS embebido de Docker)
    #   Railway:        [fd12::10] (DNS interno, IPv6)
    # Las IPs de los servicios cambian en cada redespliegue; por eso los
    # upstreams se resuelven en tiempo de petición y no al arrancar Nginx.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=on;
    resolver_timeout 5s;

    # Conserva el proto que envía el edge (Railway termina TLS) y cae a
    # $scheme cuando la petición llega directa (entorno local).
    map $http_x_forwarded_proto $forwarded_proto {
        default $http_x_forwarded_proto;
        ""      $scheme;
    }

    # Clave de rate limiting: X-Forwarded-For cuando existe (Railway) o la
    # IP directa en local. El throttle de DRF sigue siendo la protección
    # principal por usuario/IP.
    map $http_x_forwarded_for $limit_key {
        default $http_x_forwarded_for;
        ""      $binary_remote_addr;
    }

    # Rate limiting por dirección IP (protección básica ante abuso)
    limit_req_zone $limit_key zone=api_limit:10m rate=10r/s;
    limit_req_zone $limit_key zone=web_limit:10m rate=30r/s;
    limit_req_status 429;

    # Compresión
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 256;
    gzip_types text/plain text/css application/json application/javascript application/xml application/xml+rss image/svg+xml text/javascript;

    server {
        listen ${PORT};
        listen [::]:${PORT};
        server_name _;

        # Upstreams resueltos por petición (ver `resolver`).
        set $frontend_upstream "http://${FRONTEND_HOST}:${FRONTEND_PORT}";
        set $backend_upstream "http://${BACKEND_HOST}:${BACKEND_PORT}";

        # Cabeceras de seguridad
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(self), camera=(), microphone=()" always;

        # Healthcheck del proxy (sin pasar a upstream)
        location = /healthz {
            access_log off;
            add_header Content-Type application/json;
            return 200 '{"status":"ok","service":"proxy"}';
        }

        # API -> backend
        location /api/ {
            limit_req zone=api_limit burst=20 nodelay;
            proxy_pass $backend_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header Connection "";
        }

        # Aplicación SPA -> frontend
        location / {
            limit_req zone=web_limit burst=60 nodelay;
            proxy_pass $frontend_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header Connection "";
        }
    }
}
