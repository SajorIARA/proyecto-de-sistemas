# ============================================================
# PostgreSQL
# ============================================================
POSTGRES_DB=turismo-melgarejo
POSTGRES_USER=cobol
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ============================================================
# Django
# ============================================================
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-this-in-local-env
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=America/La_Paz
DJANGO_LOG_LEVEL=INFO
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SESSION_COOKIE_SECURE=0
DJANGO_CSRF_COOKIE_SECURE=0

# ============================================================
# CORS
# ============================================================
CORS_ALLOWED_ORIGINS=http://localhost

# ============================================================
# Gunicorn (producción)
# ============================================================
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

# ============================================================
# Frontend (https://vitejs.dev/guide/env-and-mode)
# ============================================================
VITE_API_URL=/api
# Nombre del cloud de Cloudinary (mismo que CLOUDINARY_CLOUD_NAME) expuesto
# al bundle del frontend para construir las URLs de entrega de imágenes.
VITE_CLOUDINARY_CLOUD_NAME=tu-cloud-name

# ============================================================
# Docker / imágenes
# ============================================================
IMAGE_TAG=latest
REGISTRY=raisiar
IMAGE_PREFIX=proyecto-de-sistemas
# ============================================================
# Cloudinary (medios: firma de subidas + CDN de imágenes)
# Obligatorias para habilitar fotos (vacías = endpoint firma -> 503).
# NO commitear valores reales: solo Secrets del entorno / Railway.
# ============================================================
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret

# ============================================================
# Celery + Redis (tareas async; igual que docker-compose)
# ============================================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ============================================================
# Docs OpenAPI (0 = ocultas, recomendado en producción)
# ============================================================
SERVE_DOCS=1

# ============================================================
# Scraping de conocimiento (fail-closed si no hay dominios)
# Ejemplo: lapaz.bo,bolivia.travel
# ============================================================
SCRAPER_ALLOWED_DOMAINS=
SCRAPER_USER_AGENT=TurismoMelgarejoBot/1.0 (+contacto: admin@example.com)
SCRAPER_TIMEOUT_SECONDS=15
SCRAPER_MAX_BYTES=2097152
SCRAPER_MAX_REDIRECTS=3
SCRAPER_MIN_INTERVAL_SECONDS=1
SCRAPER_CHUNK_CHARS=1200
SCRAPER_CHUNK_OVERLAP_CHARS=200

# ============================================================
# IA local (Ollama aislado; docker-compose.ollama.yml)
# ============================================================
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_EMBED_MODEL=embeddinggemma:300m
OLLAMA_LLM_MODEL=qwen3:0.6b
EMBEDDING_DIM=768
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_RETRIES=2
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_MAX_PREDICT=384
SCRAPER_AUTO_EMBED=1
