# ============================================================
# PostgreSQL
# ============================================================
POSTGRES_DB=turismo-melgarejo
POSTGRES_USER=cobol
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# PostgreSQL externo (Supabase, Neon, Railway, etc.).
# Si DATABASE_URL no está vacío, TIENE PRIORIDAD sobre POSTGRES_*.
# En Supabase: Connect → Session Pooler (IPv4, puerto 5432), no la conexión
# directa (db.<ref>.supabase.co es solo IPv6).
# DATABASE_URL=postgresql://postgres.<REF>:<PASSWORD>@<HOST>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# Segundos que Django reutiliza una conexión (0 = cerrar en cada petición).
DB_CONN_MAX_AGE=600
# Supabase exige TLS. Vacío = 0 con DEBUG=1 y 1 con DEBUG=0.
DB_SSL_REQUIRE=

# ============================================================
# Django
# ============================================================
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-this-in-local-env
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=America/La_Paz
DJANGO_LOG_LEVEL=INFO
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SESSION_COOKIE_SECURE=0
DJANGO_CSRF_COOKIE_SECURE=0
# Proxies de confianza delante de Django (local: 1; Railway: 2).
DJANGO_NUM_PROXIES=1
# Orígenes de confianza para CSRF, separados por coma. En Railway:
# https://<servicio>.up.railway.app
DJANGO_CSRF_TRUSTED_ORIGINS=

# ============================================================
# CORS
# ============================================================
CORS_ALLOWED_ORIGINS=http://localhost

# ============================================================
# Gunicorn (producción)
# ============================================================
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

# ============================================================
# Frontend (https://vitejs.dev/guide/env-and-mode)
# ============================================================
VITE_API_URL=/api
# Nombre del cloud de Cloudinary (mismo que CLOUDINARY_CLOUD_NAME) expuesto
# al bundle del frontend para construir las URLs de entrega de imágenes.
VITE_CLOUDINARY_CLOUD_NAME=tu-cloud-name

# ============================================================
# Docker / imágenes
# ============================================================
IMAGE_TAG=latest
REGISTRY=raisiar
IMAGE_PREFIX=proyecto-de-sistemas
# ============================================================
# Cloudinary (medios: firma de subidas + CDN de imágenes)
# Obligatorias para habilitar fotos (vacías = endpoint firma -> 503).
# NO commitear valores reales: solo Secrets del entorno / Railway.
# ============================================================
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret

# ============================================================
# Celery + Redis (tareas async; igual que docker-compose)
# ============================================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ============================================================
# Docs OpenAPI (0 = ocultas, recomendado en producción)
# ============================================================
SERVE_DOCS=1

# ============================================================
# Scraping de conocimiento (fail-closed si no hay dominios)
# Ejemplo: lapaz.bo,bolivia.travel
# ============================================================
SCRAPER_ALLOWED_DOMAINS=lapaz.bo,www.lapaz.bo,sitservicios.lapaz.bo,www.wikidata.org,query.wikidata.org,commons.wikimedia.org,upload.wikimedia.org,thumb.wikimedia.org,nominatim.openstreetmap.org,overpass-api.de,maps.mail.ru,es.wikipedia.org,en.wikipedia.org,miteleferico.bo,www.miteleferico.bo,www.aecid.es,ccelp.aecid.es,laboliviana.com,larufinabolivia.com,www.instagram.com,www.facebook.com,www.tiktok.com
SCRAPER_USER_AGENT=TurismoMelgarejoBot/1.0 (+contacto: admin@example.com)
SCRAPER_TIMEOUT_SECONDS=15
SCRAPER_MAX_BYTES=2097152
SCRAPER_MAX_REDIRECTS=3
SCRAPER_MIN_INTERVAL_SECONDS=1
SCRAPER_CHUNK_CHARS=1200
SCRAPER_CHUNK_OVERLAP_CHARS=200

# Descubrimiento en fuentes abiertas (backend; la UI nunca las llama)
# URLs públicas por defecto. Ajustar solo para probar otro endpoint autorizado.
FUENTES_ABIERTAS_TIMEOUT_SECONDS=25
FUENTES_ABIERTAS_MAX_BYTES=3145728
FUENTES_ABIERTAS_MIN_INTERVAL_SECONDS=1.0
FUENTES_ABIERTAS_REINTENTOS_OVERPASS=1
FUENTES_ABIERTAS_OVERPASS_URL=https://overpass-api.de/api/interpreter
# Espejos en orden de intento; vacío usa los incluidos en settings.py.
FUENTES_ABIERTAS_OVERPASS_URLS=
FUENTES_ABIERTAS_WIKIDATA_URL=https://www.wikidata.org/w/api.php
FUENTES_ABIERTAS_USER_AGENT=TurismoMelgarejoBot/1.0 (+contacto: admin@example.com)
# Los bridges de Docker no tienen salida en local: egress-proxy corre en el
# host y se usa por socket Unix compartido (evita el firewall del host).
# Déjalo vacío si tu entorno ya permite internet desde los contenedores.
EGRESS_PROXY_SOCKET=/app/staging/egress-proxy.sock
EGRESS_PROXY_TIMEOUT=30
EGRESS_PROXY_ALLOWED_HOSTS=overpass-api.de,maps.mail.ru,overpass.kumi.systems,www.wikidata.org,query.wikidata.org,nominatim.openstreetmap.org,lapaz.bo,www.lapaz.bo,sitservicios.lapaz.bo,miteleferico.bo,www.miteleferico.bo,commons.wikimedia.org,upload.wikimedia.org,thumb.wikimedia.org,api.cloudinary.com,es.wikipedia.org,en.wikipedia.org,www.openstreetmap.org,www.aecid.es,ccelp.aecid.es,laboliviana.com,www.laboliviana.com,larufinabolivia.com,www.larufinabolivia.com,www.instagram.com,www.facebook.com,www.tiktok.com
FUENTES_ABIERTAS_PROXY_URL=unix:///app/staging/egress-proxy.sock

# ============================================================
# IA local (Ollama aislado; docker-compose.ollama.yml)
# ============================================================
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_EMBED_MODEL=embeddinggemma:300m
OLLAMA_LLM_MODEL=qwen3:0.6b
EMBEDDING_DIM=768
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_RETRIES=2
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_MAX_PREDICT=384
SCRAPER_AUTO_EMBED=1

# ============================================================
# Asistente RAG (POST /api/conocimiento/consultar/)
# ============================================================
RAG_TOP_K=4
RAG_UMBRAL=0.65
RAG_MAX_PREGUNTA=500
RAG_THROTTLE_ANON=10/minute
RAG_THROTTLE_USER=30/minute

# ============================================================
# Proxy (Nginx)
# ============================================================
# Puerto en el que escucha Nginx. Railway inyecta PORT automáticamente.
PROXY_PORT=80
FRONTEND_HOST=frontend
FRONTEND_PORT=3000
BACKEND_HOST=backend
BACKEND_PORT=8000
# 127.0.0.11 = DNS de Docker Compose; [fd12::10] = DNS privado de Railway.
NGINX_RESOLVER=127.0.0.11
